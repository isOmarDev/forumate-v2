{
  "name": "@forumate/backend",
  "version": "1.0.0",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "nodemon",
    "start": "node --import tsx dist/index.js",
    "test": "tsx run-jest.ts",
    "test:dev": "tsx run-jest.ts --watchAll",
    "test:e2e": "tsx run-jest.ts -c jest.config.e2e.ts",
    "test:infra": "tsx run-jest.ts -c jest.config.infra.ts",
    "test:unit": "tsx run-jest.ts -c jest.config.unit.ts"
  },
  "dependencies": {
    "@forumate/api": "workspace:*",
    "@forumate/bus": "workspace:*",
    "@forumate/config": "workspace:*",
    "@forumate/core": "workspace:*",
    "@forumate/database": "workspace:*",
    "@forumate/errors": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.11",
    "onchange": "^7.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0"
  }
}
