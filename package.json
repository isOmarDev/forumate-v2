{
  "name": "forumate",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "scripts": {
    "init": "pnpm install && pnpm --filter @forumate/database generate && pnpm --filter @forumate/database migrate",
    "dev": "turbo run dev",
    "dev:back": "pnpm --filter @forumate/backend dev",
    "dev:front": "pnpm --filter @forumate/frontend dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "build": "turbo run build",
    "build:back": "pnpm --filter @forumate/backend build",
    "build:front": "pnpm --filter @forumate/frontend build",
    "start": "pnpm --filter @forumate/backend start",
    "start:db": "docker-compose up -d",
    "stop:db": "docker-compose down",
    "stop:db:volumes": "docker-compose down -v",
    "db:logs": "docker-compose logs -f",
    "db:generate": "pnpm --filter @forumate/database generate",
    "db:migrate": "pnpm --filter @forumate/database migrate",
    "db:seed": "pnpm --filter @forumate/database seed",
    "db:reset": "pnpm --filter @forumate/database reset",
    "db:studio": "pnpm --filter @forumate/database studio",
    "test:unit:back": "pnpm --filter @forumate/backend test:unit",
    "test:infra:back": "pnpm --filter @forumate/backend test:infra",
    "test:e2e:back": "pnpm --filter @forumate/backend test:e2e",
    "test:e2e:front": "pnpm --filter @forumate/frontend test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-cucumber": "^4.5.0",
    "jest-mock-extended": "4.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
