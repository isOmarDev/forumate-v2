{
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": ["clean", "^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
